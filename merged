#!/usr/bin/perl

use strict;

my @upstreams = qw(next);
while (@ARGV) {
  my $arg = shift @ARGV;
  if ($arg eq "--jch") {
    push @upstreams, 'jch';
  } elsif ($arg eq "--seen") {
    push @upstreams, 'seen';
  } else {
    die "unknown option: $arg\n";
  }
}

my @topics = do {
  open(my $fh, '-|', qw(Meta/topics -t));
  grep { !/-(?:wip|stale)$/ } map { chomp; $_ } <$fh>
};

my %topic_to_commit;
open(my $fh, '-|', qw(git log --format=%H:%S ^origin), @topics);
while (<$fh>) {
  chomp;
  my ($h, $t) = split /:/;
  push @{$topic_to_commit{$t}}, $h;
};

my %commit_to_patch = do {
  my $t = join(" ", map { quotemeta } @topics);
  open(my $fh, '-|', "git log -p ^origin $t | git patch-id");
  map { chomp; reverse split } <$fh>
};

my %upstream;
for my $u (@upstreams) {
  open(my $fh, '-|', "git log -p ^origin origin/$u | git patch-id");
  my %p;
  while (<$fh>) {
    chomp;
    my ($patch) = split;
    $p{$patch} = 1;
  }
  $upstream{$u} = \%p;
}

TOPIC:
for my $t (@topics) {
  my $commits = $topic_to_commit{$t};
  if (!$commits) {
    show($t, "merged to master");
    next;
  }

  for my $u (@upstreams) {
    my $merged = 0;
    for my $commit (@$commits) {
      $merged++ if $upstream{$u}{$commit_to_patch{$commit}};
    }
    if ($merged) {
      show($t, "merged to $u" . ($merged == @$commits ? "" : " (partial)"));
      next TOPIC;
    }
  }
  show($t, "not merged");
}

sub show {
  printf "%30s: %s\n", @_;
}
