#!/usr/bin/perl

use strict;

my @upstreams = qw(master next jch);
while (@ARGV) {
  my $arg = shift @ARGV;
  if ($arg eq "--seen") {
    push @upstreams, 'seen';
  } else {
    die "unknown option: $arg\n";
  }
}

my @topics = do {
  open(my $fh, '-|', qw(Meta/topics -t));
  grep { !/-(?:wip|stale)$/ } map { chomp; $_ } <$fh>
};

for my $u (@upstreams) {
  next unless @topics;
  my $rhs = join(" ", map { quotemeta } @topics);
  open(my $fh, '-|',
    "git log --cherry-mark --right-only --format=%m:%S origin/$u...$rhs");
  my %merged;
  my %unmerged;
  while (<$fh>) {
    chomp;
    my ($m, $t) = split /:/;
    if ($m eq '=') {
      $merged{$t}++;
    } else {
      $unmerged{$t}++;
    }
  }

  my @remain;
  for my $t (@topics) {
    if (!$unmerged{$t}) {
      show($t, "merged to $u");
    } elsif ($merged{$t}) {
      show($t, "merged to $u (partial)");
    } else {
      push @remain, $t;
    }
  }

  @topics = @remain;
}

for my $t (@topics) {
  show($t, "not merged");
}

sub show {
  printf "%30s: %s\n", @_;
}
