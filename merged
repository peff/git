#!/bin/sh

show() {
	printf '%30s: %s\n' "$1" "$2"
}

check_merge() {
	local merged
	local partial
	local commit
	for commit in $(git cherry $2 $1 | cut -d' ' -f1); do
		case "$commit" in
		-) merged=t ;;
		+) partial=" (partial)" ;;
		esac
	done
	if test -n "$merged"; then
		show $1 "merged to $2${partial}"
		return 0
	fi
	return 1
}

check_seen=
check_jch=
while test $# -gt 0; do
	case "$1" in
	--seen)
		check_seen=t
		;;
	--jch)
		check_jch=t
		;;
	*)
		echo >&2 "unknown option: $1"
		exit 1
		;;
	esac
	shift
done

for i in `Meta/topics -t`; do
	case "$i" in
	*-wip|*-stale)
		continue
		;;
	esac

	check_merge $i origin/master ||
	check_merge $i origin/next ||
	{ test -n "$check_jch" && check_merge $i origin/jch; } ||
	{ test -n "$check_seen" && check_merge $i origin/seen; } ||
	show $i 'not merged'
done
exit 0
